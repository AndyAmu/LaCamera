---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<header class="sticky top-0 z-50 bg-[#0F1E36] text-white shadow-md border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4 xl:gap-6">
    
    <!-- Logo + Rating Badge -->
    <div class="flex items-center gap-3 xl:gap-5 shrink-0">
      <a href="/" class="flex items-center group py-2 shrink-0" aria-label="Estudio La Cámera - Inicio">
        <img
          src={siteData.images.logo}
          alt={siteData.logo.alt}
          width="230"
          height="44"
          class="h-10 sm:h-11 w-auto object-contain shrink-0"
          loading="eager"
          decoding="async"
          onerror={`this.onerror=null;this.src='${siteData.images.logoFallback}'`}
        />
      </a>

      <!-- Rating Badge in 1 single line -->
      <a
        href="#resenas"
        class="hidden xl:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 border border-amber-400/40 text-xs font-medium text-white whitespace-nowrap shrink-0 hover:bg-white/15 transition"
        title="Ver reseñas en Google"
      >
        <span class="text-amber-400 font-bold">★</span>
        <span class="font-bold reviews-rating-val">{siteData.reviews.rating}</span>
        <span class="text-white/80">· <span class="reviews-count-dynamic">{siteData.reviews.count}</span> reseñas en Google</span>
      </a>
    </div>

    <!-- Desktop Navigation Menu (No line breaks) -->
    <nav class="hidden lg:flex items-center gap-5 xl:gap-7" aria-label="Navegación principal">
      <a
        href="#como-trabajamos"
        class="text-sm font-medium text-slate-200 hover:text-white whitespace-nowrap transition-colors"
      >
        Cómo trabajamos
      </a>
      <a
        href="#casos"
        class="text-sm font-medium text-slate-200 hover:text-white whitespace-nowrap transition-colors"
      >
        Casos
      </a>
      <a
        href="#resenas"
        class="text-sm font-medium text-slate-200 hover:text-white whitespace-nowrap transition-colors"
      >
        Reseñas
      </a>
      <a
        href="#preguntas-frecuentes"
        class="text-sm font-medium text-slate-200 hover:text-white whitespace-nowrap transition-colors"
      >
        Preguntas frecuentes
      </a>
      <a
        href="#contacto"
        class="text-sm font-medium text-slate-200 hover:text-white whitespace-nowrap transition-colors"
      >
        Contacto
      </a>
    </nav>

    <!-- Right Action: Proportioned & Elegant WhatsApp Button -->
    <div class="hidden lg:inline-flex items-center shrink-0">
      <a
        href={siteData.whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="track-whatsapp hidden lg:inline-flex items-center gap-2 bg-[#16A34A] hover:bg-[#15803D] text-white text-sm font-semibold px-4 py-2.5 rounded-lg shadow-sm whitespace-nowrap shrink-0 transition-all"
        data-location="header"
      >
        <Icons name="whatsapp" class="w-4 h-4 shrink-0 text-white" />
        <span>Escribinos por WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Controls -->
    <div class="flex items-center gap-2 lg:hidden">
      <!-- Mobile Stars Badge -->
      <a
        href="#resenas"
        class="inline-flex sm:hidden items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold text-white bg-white/10 border border-amber-400/40 shrink-0"
        title="Ver reseñas"
      >
        <span class="text-amber-400">★ <span class="reviews-rating-val">{siteData.reviews.rating}</span></span>
        <span class="text-white/80">(<span class="reviews-count-dynamic">{siteData.reviews.count}</span>)</span>
      </a>

      <!-- Hamburger Button -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="p-2.5 rounded-lg text-slate-200 hover:text-white hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-amber-400"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
        aria-label="Abrir menú de navegación"
      >
        <span id="menu-icon-open">
          <Icons name="menu" class="w-6 h-6" />
        </span>
        <span id="menu-icon-close" class="hidden">
          <Icons name="close" class="w-6 h-6" />
        </span>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu (Matching Dark Institutional Theme) -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden bg-[#0F1E36] border-b border-white/10 px-4 pt-2 pb-6 space-y-3 transition-all"
  >
    <nav class="flex flex-col space-y-1 pt-2" aria-label="Menú mobile">
      <a
        href="#como-trabajamos"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white block transition-colors"
      >
        Cómo trabajamos
      </a>
      <a
        href="#casos"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white block transition-colors"
      >
        Casos
      </a>
      <a
        href="#resenas"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white block transition-colors"
      >
        Reseñas
      </a>
      <a
        href="#que-hacer"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white block transition-colors"
      >
        Qué hacer tras un accidente
      </a>
      <a
        href="#preguntas-frecuentes"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white block transition-colors"
      >
        Preguntas frecuentes
      </a>
      <a
        href="#visitanos"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-medium text-slate-200 hover:bg-white/10 hover:text-white block transition-colors"
      >
        Vení a tomar un café
      </a>
      <a
        href="#contacto"
        class="mobile-menu-link px-3 py-2.5 rounded-lg text-base font-semibold text-amber-400 hover:bg-white/10 hover:text-amber-300 block transition-colors"
      >
        Contacto
      </a>
    </nav>
    <div class="pt-3 border-t border-white/10">
      <a
        href={siteData.whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="track-whatsapp flex items-center justify-center gap-2 w-full py-3 rounded-lg font-semibold text-white bg-[#16A34A] hover:bg-[#15803D] shadow-sm transition-colors"
        data-location="mobile-menu"
      >
        <Icons name="whatsapp" class="w-5 h-5 text-white" />
        <span>Escribinos por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const drawer = document.getElementById("mobile-menu-drawer");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");
    const links = document.querySelectorAll(".mobile-menu-link");

    if (!toggle || !drawer) return;

    const toggleMenu = (open?: boolean) => {
      const isExpanded = open !== undefined ? !open : toggle.getAttribute("aria-expanded") === "true";
      const willOpen = !isExpanded;

      toggle.setAttribute("aria-expanded", String(willOpen));
      if (willOpen) {
        drawer.classList.remove("hidden");
        iconOpen?.classList.add("hidden");
        iconClose?.classList.remove("hidden");
      } else {
        drawer.classList.add("hidden");
        iconOpen?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
      }
    };

    toggle.addEventListener("click", () => toggleMenu());

    links.forEach((link) => {
      link.addEventListener("click", () => toggleMenu(false));
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeader);
  } else {
    setupHeader();
  }
</script>
