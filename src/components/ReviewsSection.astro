---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<section id="resenas" class="py-16 sm:py-24 bg-cream-100/60 scroll-mt-20 border-t border-cream-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-bold tracking-wider text-amber-800 uppercase font-sans">
          Opiniones reales
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-navy-950 font-serif mt-1 mb-2">
          Lo que dicen quienes ya pasaron por esto
        </h2>
        <div class="inline-flex items-center gap-2 mt-2 px-3 py-1.5 rounded-full bg-white border border-cream-300 shadow-sm">
          <div class="flex text-amber-500">
            {Array.from({ length: 5 }).map(() => (
              <Icons name="star" class="w-4 h-4 text-amber-500 fill-amber-500" />
            ))}
          </div>
          <span class="text-xs sm:text-sm font-bold text-navy-950 reviews-display-dynamic">
            ★ <span class="reviews-rating-val">{siteData.reviews.rating}</span> · <span class="reviews-count-dynamic">{siteData.reviews.count}</span> reseñas en Google
          </span>
        </div>
      </div>

      <!-- Top Google Map Link Button (Desktop) -->
      <div class="hidden sm:block">
        <a
          href={siteData.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="track-reviews inline-flex items-center gap-2 px-5 py-3 rounded-xl font-semibold text-sm text-navy-900 bg-white hover:bg-cream-50 border border-slate-300 transition-all shadow-sm hover:shadow"
        >
          <span>Ver todas las reseñas en Google</span>
          <Icons name="externalLink" class="w-4 h-4 text-navy-700" />
        </a>
      </div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {siteData.sampleReviews.map((rev) => (
        <div class="flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-white border border-cream-200/90 shadow-soft">
          <div>
            <!-- Review Top: Avatar/Initials + Name + Date -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-navy-900 text-cream-100 font-bold flex items-center justify-center text-sm shadow-sm">
                  {rev.initials || rev.name.charAt(0)}
                </div>
                <div>
                  <h3 class="text-sm font-bold text-navy-950">
                    {rev.name}
                  </h3>
                  <p class="text-xs text-slate-500">
                    {rev.date}
                  </p>
                </div>
              </div>

              <!-- Google Badge / 5 Stars -->
              <div class="flex text-amber-500">
                {Array.from({ length: rev.rating }).map(() => (
                  <Icons name="star" class="w-3.5 h-3.5 fill-amber-500" />
                ))}
              </div>
            </div>

            <!-- Review Text -->
            <p class="text-sm text-slate-700 leading-relaxed italic">
              "{rev.text}"
            </p>
          </div>

          <!-- Bottom Verified Google review badge and link -->
          <div class="pt-4 mt-4 border-t border-cream-100 flex items-center justify-between gap-2 text-xs">
            <div class="flex items-center gap-1.5 text-slate-500">
              <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              <span>Reseña verificada</span>
            </div>
            {rev.url && (
              <a
                href={rev.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-navy-900 hover:text-amber-700 transition-colors"
                title={`Ver reseña de ${rev.name} en Google`}
              >
                <span>Ver en Google</span>
                <Icons name="externalLink" class="w-3.5 h-3.5 shrink-0" />
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Button for Mobile -->
    <div class="mt-8 text-center sm:hidden">
      <a
        href={siteData.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="track-reviews inline-flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-xl font-semibold text-sm text-navy-900 bg-white hover:bg-cream-50 border border-slate-300 shadow-sm"
      >
        <span>Ver todas las reseñas en Google</span>
        <Icons name="externalLink" class="w-4 h-4 text-navy-700" />
      </a>
    </div>

  </div>
</section>
