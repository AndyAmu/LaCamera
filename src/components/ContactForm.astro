---
import { siteData } from "../config/siteData";

interface Props {
  formOrigin: "hero" | "contacto_final";
  title?: string;
  subtitle?: string;
}

const { formOrigin, title, subtitle } = Astro.props;
const formId = `form-${formOrigin}`;
---

<div class="bg-white rounded-2xl p-6 sm:p-8 shadow-card border border-cream-200/80">
  {title && (
    <h3 class="text-xl sm:text-2xl font-bold text-navy-950 font-serif mb-1">
      {title}
    </h3>
  )}
  {subtitle && (
    <p class="text-sm text-slate-600 mb-6">
      {subtitle}
    </p>
  )}

  <form id={formId} class="space-y-4 contact-form" novalidate data-origin={formOrigin}>
    <!-- Hidden Honeypot anti-spam -->
    <div class="hidden" aria-hidden="true">
      <label for={`${formId}-website`}>No completar este campo</label>
      <input type="text" id={`${formId}-website`} name="website" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Hidden Tracking Fields -->
    <input type="hidden" name="origen_formulario" value={formOrigin} />
    <input type="hidden" name="origen_visita" class="input-origen-visita" value="Directo" />

    <!-- 1. Nombre y apellido -->
    <div>
      <label for={`${formId}-nombre`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Nombre y apellido <span class="text-amber-700" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id={`${formId}-nombre`}
        name="nombre"
        placeholder="Ej.: Juan Pérez"
        required
        autocomplete="name"
        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-navy-800 focus:ring-1 focus:ring-navy-800 text-slate-900 text-sm transition-colors placeholder:text-slate-400 bg-cream-50/40"
      />
      <p class="error-msg hidden text-xs text-red-600 mt-1 font-medium" id={`${formId}-nombre-error`}>
        Escribí tu nombre para que sepamos cómo llamarte.
      </p>
    </div>

    <!-- 2. Teléfono -->
    <div>
      <label for={`${formId}-telefono`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Teléfono <span class="text-amber-700" aria-hidden="true">*</span>
      </label>
      <input
        type="tel"
        id={`${formId}-telefono`}
        name="telefono"
        placeholder="Con código de área, sin 0 ni 15. Ej.: 11 1234-5678"
        required
        autocomplete="tel"
        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-navy-800 focus:ring-1 focus:ring-navy-800 text-slate-900 text-sm transition-colors placeholder:text-slate-400 bg-cream-50/40"
      />
      <p class="error-msg hidden text-xs text-red-600 mt-1 font-medium" id={`${formId}-telefono-error`}>
        Revisá el número: tiene que tener 10 dígitos con el código de área (ej.: 11 1234-5678).
      </p>
    </div>

    <!-- 3. Email (Opcional) -->
    <div>
      <label for={`${formId}-email`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Email <span class="text-xs text-slate-500 font-normal lowercase">(opcional)</span>
      </label>
      <input
        type="email"
        id={`${formId}-email`}
        name="email"
        placeholder="Para enviarte la confirmación de tu consulta. Ej.: juan@gmail.com"
        autocomplete="email"
        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-navy-800 focus:ring-1 focus:ring-navy-800 text-slate-900 text-sm transition-colors placeholder:text-slate-400 bg-cream-50/40"
      />
      <p class="error-msg hidden text-xs text-red-600 mt-1 font-medium" id={`${formId}-email-error`}>
        Revisá el email, parece que falta algo.
      </p>
    </div>

    <!-- 4. Tipo de accidente -->
    <div>
      <label for={`${formId}-tipo_accidente`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Tipo de accidente <span class="text-amber-700" aria-hidden="true">*</span>
      </label>
      <div class="relative">
        <select
          id={`${formId}-tipo_accidente`}
          name="tipo_accidente"
          required
          class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-navy-800 focus:ring-1 focus:ring-navy-800 text-slate-900 text-sm transition-colors bg-cream-50/40 appearance-none pr-10"
        >
          <option value="" disabled selected>Elegí una opción</option>
          {siteData.accidentTypes.map((type) => (
            <option value={type}>{type}</option>
          ))}
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </div>
      </div>
      <p class="error-msg hidden text-xs text-red-600 mt-1 font-medium" id={`${formId}-tipo_accidente-error`}>
        Elegí el tipo de accidente.
      </p>
    </div>

    <!-- 5. ¿Hubo lesionados? (Opcional) -->
    <div>
      <span class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">
        ¿Hubo lesionados? <span class="text-xs text-slate-500 font-normal lowercase">(opcional)</span>
      </span>
      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 text-sm text-slate-800 cursor-pointer">
          <input
            type="radio"
            name="hubo_lesionados"
            value="Sí"
            class="w-4 h-4 text-navy-800 focus:ring-navy-800 border-slate-300"
          />
          <span>Sí</span>
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-800 cursor-pointer">
          <input
            type="radio"
            name="hubo_lesionados"
            value="No"
            class="w-4 h-4 text-navy-800 focus:ring-navy-800 border-slate-300"
          />
          <span>No</span>
        </label>
      </div>
    </div>

    <!-- 6. Contanos qué pasó (Opcional) -->
    <div>
      <label for={`${formId}-mensaje`} class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
        Contanos qué pasó <span class="text-xs text-slate-500 font-normal lowercase">(opcional)</span>
      </label>
      <textarea
        id={`${formId}-mensaje`}
        name="mensaje"
        rows="3"
        placeholder="Cuándo y dónde fue, cómo pasó y si ya hablaste con el seguro"
        class="w-full px-3.5 py-2.5 rounded-lg border border-slate-300 focus:border-navy-800 focus:ring-1 focus:ring-navy-800 text-slate-900 text-sm transition-colors placeholder:text-slate-400 bg-cream-50/40 resize-y"
      ></textarea>
    </div>

    <!-- 7. Casilla de privacidad -->
    <div class="pt-1">
      <label class="flex items-start gap-3 cursor-pointer">
        <input
          type="checkbox"
          id={`${formId}-politica_privacidad`}
          name="politica_privacidad"
          required
          class="mt-1 w-4 h-4 rounded text-navy-800 focus:ring-navy-800 border-slate-300"
        />
        <span class="text-xs sm:text-sm text-slate-600 leading-snug">
          Acepto la{" "}
          <a
            href="/politica-de-privacidad"
            target="_blank"
            class="text-navy-800 underline hover:text-navy-950 font-medium"
          >
            política de privacidad
          </a>
        </span>
      </label>
      <p class="error-msg hidden text-xs text-red-600 mt-1 font-medium" id={`${formId}-politica_privacidad-error`}>
        Para enviar la consulta, aceptá la política de privacidad.
      </p>
    </div>

    <!-- Error general del envío -->
    <div
      class="form-general-error hidden p-3 rounded-lg bg-red-50 border border-red-200 text-xs sm:text-sm text-red-700"
      role="alert"
    >
      <p class="font-medium mb-1">No pudimos enviar tu consulta. Probá de nuevo o escribinos por WhatsApp.</p>
      <a
        href={siteData.whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-semibold text-whatsapp-dark hover:underline"
      >
        Escribinos por WhatsApp ahora &rarr;
      </a>
    </div>

    <!-- Botón submit -->
    <div class="pt-2">
      <button
        type="submit"
        class="submit-btn w-full inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-semibold text-base text-white bg-navy-900 hover:bg-navy-800 active:scale-[0.99] transition-all shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-navy-800 focus:ring-offset-2 disabled:opacity-60 disabled:cursor-not-allowed"
      >
        <span class="btn-text">Enviar consulta</span>
        <span class="btn-spinner hidden items-center gap-2">
          <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Enviando…</span>
        </span>
      </button>
      <p class="text-center text-xs text-slate-500 mt-2.5">
        Tus datos son confidenciales y solo los usamos para responder tu consulta.
      </p>
    </div>
  </form>
</div>

<script>
  // Reusable Form Validation and Submission Handler
  function initForms() {
    const forms = document.querySelectorAll<HTMLFormElement>(".contact-form");

    // Detect visit origin (campaign, search, social, direct)
    const urlParams = new URLSearchParams(window.location.search);
    let visitOrigin = "Directo";
    const utmSource = urlParams.get("utm_source");
    const utmMedium = urlParams.get("utm_medium");
    const utmCampaign = urlParams.get("utm_campaign");

    if (utmSource || utmCampaign) {
      visitOrigin = `Campaña: ${[utmSource, utmMedium, utmCampaign].filter(Boolean).join(" / ")}`;
    } else if (document.referrer) {
      const ref = document.referrer.toLowerCase();
      if (ref.includes("google") || ref.includes("bing") || ref.includes("yahoo") || ref.includes("duckduckgo")) {
        visitOrigin = `Buscador (${new URL(document.referrer).hostname})`;
      } else if (ref.includes("instagram") || ref.includes("facebook") || ref.includes("tiktok") || ref.includes("linkedin") || ref.includes("twitter") || ref.includes("t.co")) {
        visitOrigin = `Redes sociales (${new URL(document.referrer).hostname})`;
      } else {
        visitOrigin = `Referido (${new URL(document.referrer).hostname})`;
      }
    }

    forms.forEach((form) => {
      // Set visit origin in hidden input
      const originInput = form.querySelector<HTMLInputElement>(".input-origen-visita");
      if (originInput) originInput.value = visitOrigin;

      // Detect Focus on Form to notify Mobile Bottom Bar
      form.addEventListener("focusin", () => {
        window.dispatchEvent(new CustomEvent("form-focus-change", { detail: { focused: true } }));
      });
      form.addEventListener("focusout", (e) => {
        // Only trigger if focus left the entire form
        setTimeout(() => {
          if (!form.contains(document.activeElement)) {
            window.dispatchEvent(new CustomEvent("form-focus-change", { detail: { focused: false } }));
          }
        }, 100);
      });

      // Realtime validation
      const nombreInput = form.querySelector<HTMLInputElement>('input[name="nombre"]');
      const telefonoInput = form.querySelector<HTMLInputElement>('input[name="telefono"]');
      const emailInput = form.querySelector<HTMLInputElement>('input[name="email"]');
      const tipoSelect = form.querySelector<HTMLSelectElement>('select[name="tipo_accidente"]');
      const politicaCheckbox = form.querySelector<HTMLInputElement>('input[name="politica_privacidad"]');
      const generalError = form.querySelector<HTMLElement>(".form-general-error");
      const submitBtn = form.querySelector<HTMLButtonElement>(".submit-btn");
      const btnText = form.querySelector<HTMLElement>(".btn-text");
      const btnSpinner = form.querySelector<HTMLElement>(".btn-spinner");

      const toggleError = (field: HTMLElement | null, errorElId: string, hasError: boolean) => {
        const errorEl = form.querySelector<HTMLElement>(`#${errorElId}`);
        if (!field || !errorEl) return;
        if (hasError) {
          errorEl.classList.remove("hidden");
          field.classList.add("border-red-500", "bg-red-50/20");
        } else {
          errorEl.classList.add("hidden");
          field.classList.remove("border-red-500", "bg-red-50/20");
        }
      };

      // Input listeners to clear error upon typing
      nombreInput?.addEventListener("input", () => {
        if (nombreInput.value.trim().length > 0) {
          toggleError(nombreInput, `${form.id}-nombre-error`, false);
        }
      });

      telefonoInput?.addEventListener("input", () => {
        const digits = telefonoInput.value.replace(/\D/g, "");
        if (digits.length >= 10) {
          toggleError(telefonoInput, `${form.id}-telefono-error`, false);
        }
      });

      emailInput?.addEventListener("input", () => {
        const val = emailInput.value.trim();
        if (val.length === 0 || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
          toggleError(emailInput, `${form.id}-email-error`, false);
        }
      });

      tipoSelect?.addEventListener("change", () => {
        if (tipoSelect.value && tipoSelect.value !== "") {
          toggleError(tipoSelect, `${form.id}-tipo_accidente-error`, false);
        }
      });

      politicaCheckbox?.addEventListener("change", () => {
        if (politicaCheckbox.checked) {
          toggleError(politicaCheckbox, `${form.id}-politica_privacidad-error`, false);
        }
      });

      // Submit listener
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        generalError?.classList.add("hidden");

        let isValid = true;

        // 1. Validate Nombre
        const nombreVal = nombreInput?.value.trim() || "";
        if (!nombreVal) {
          toggleError(nombreInput, `${form.id}-nombre-error`, true);
          isValid = false;
        } else {
          toggleError(nombreInput, `${form.id}-nombre-error`, false);
        }

        // 2. Validate Teléfono (10 digits minimum)
        const telVal = telefonoInput?.value.trim() || "";
        const telDigits = telVal.replace(/\D/g, "");
        if (telDigits.length < 10) {
          toggleError(telefonoInput, `${form.id}-telefono-error`, true);
          isValid = false;
        } else {
          toggleError(telefonoInput, `${form.id}-telefono-error`, false);
        }

        // 3. Validate Email (optional, but if provided must be valid)
        const emailVal = emailInput?.value.trim() || "";
        if (emailVal && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
          toggleError(emailInput, `${form.id}-email-error`, true);
          isValid = false;
        } else {
          toggleError(emailInput, `${form.id}-email-error`, false);
        }

        // 4. Validate Tipo Accidente
        const tipoVal = tipoSelect?.value || "";
        if (!tipoVal) {
          toggleError(tipoSelect, `${form.id}-tipo_accidente-error`, true);
          isValid = false;
        } else {
          toggleError(tipoSelect, `${form.id}-tipo_accidente-error`, false);
        }

        // 5. Validate Política Privacidad
        const politicaVal = politicaCheckbox?.checked || false;
        if (!politicaVal) {
          toggleError(politicaCheckbox, `${form.id}-politica_privacidad-error`, true);
          isValid = false;
        } else {
          toggleError(politicaCheckbox, `${form.id}-politica_privacidad-error`, false);
        }

        if (!isValid) {
          // Focus first invalid field
          const firstInvalid = form.querySelector<HTMLElement>(".border-red-500, input:invalid");
          firstInvalid?.focus();
          return;
        }

        // Disable submit button & show spinner
        if (submitBtn) {
          submitBtn.disabled = true;
          btnText?.classList.add("hidden");
          btnSpinner?.classList.remove("hidden");
          btnSpinner?.classList.add("inline-flex");
        }

        const formData = new FormData(form);
        const payload: Record<string, any> = {};
        formData.forEach((val, key) => {
          if (key === "politica_privacidad") {
            payload[key] = val === "on" || val === "true";
          } else {
            payload[key] = val;
          }
        });

        try {
          const res = await fetch("/api/contacto.php", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify(payload),
          });

          const data = await res.json().catch(() => null);

          if (res.ok && data && data.success) {
            // Track Google Analytics 4 conversion if consented
            if (typeof window !== "undefined" && (window as any).gtag) {
              (window as any).gtag("event", "generate_lead", {
                event_category: "engagement",
                event_label: form.dataset.origin,
              });
            }

            // Redirect to Gracias page
            const redirectUrl = new URL("/gracias", window.location.origin);
            redirectUrl.searchParams.set("nombre", nombreVal);
            redirectUrl.searchParams.set("telefono", telVal);
            window.location.href = redirectUrl.toString();
          } else {
            throw new Error(data?.error || "Error al procesar el formulario");
          }
        } catch (err) {
          generalError?.classList.remove("hidden");
          if (submitBtn) {
            submitBtn.disabled = false;
            btnText?.classList.remove("hidden");
            btnSpinner?.classList.add("hidden");
            btnSpinner?.classList.remove("inline-flex");
          }
        }
      });
    });
  }

  // Run on page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initForms);
  } else {
    initForms();
  }
</script>
