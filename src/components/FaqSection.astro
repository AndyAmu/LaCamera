---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<section id="preguntas-frecuentes" class="py-16 sm:py-24 bg-cream-50 scroll-mt-20 border-t border-cream-200/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <span class="text-xs font-bold tracking-wider text-amber-800 uppercase font-sans">
        Respuestas claras
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-navy-950 font-serif mt-1 mb-3">
        Preguntas frecuentes
      </h2>
      <p class="text-base sm:text-lg text-slate-700">
        Las dudas más comunes de quienes tuvieron un accidente, respondidas por nuestros abogados.
      </p>
    </div>

    <!-- 5 Categories Accordion -->
    <div class="space-y-12">
      {siteData.faqCategories.map((catGroup) => (
        <div class="faq-category-block">
          <!-- Category Title (<h3>) -->
          <h3 class="text-xl sm:text-2xl font-bold text-navy-950 font-serif pb-3 mb-6 border-b-2 border-navy-900/10 flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-600 inline-block"></span>
            <span>{catGroup.category}</span>
          </h3>

          <div class="space-y-3.5">
            {catGroup.items.map((item) => (
              <details
                id={item.id}
                class="faq-item group bg-white rounded-xl border border-cream-200/90 shadow-soft overflow-hidden transition-all duration-200 scroll-mt-28"
              >
                <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer select-none focus:outline-none focus:bg-cream-50/70 hover:bg-cream-50/50 transition-colors">
                  <!-- Question (<h4>) -->
                  <h4 class="text-base sm:text-lg font-semibold text-navy-950 leading-snug group-hover:text-navy-800 text-left">
                    {item.question}
                  </h4>
                  <div class="p-1 rounded-full text-slate-400 group-hover:text-navy-900 flex-shrink-0 transition-transform duration-200 group-open:rotate-180">
                    <Icons name="chevronDown" class="w-5 h-5" />
                  </div>
                </summary>

                <!-- Full Answer Rendered Statically in Initial HTML for SEO -->
                <div class="px-5 pb-6 sm:px-6 sm:pb-7 pt-2 text-sm sm:text-base text-slate-700 leading-relaxed border-t border-cream-100 space-y-3">
                  {item.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Cierre de Sección FAQ -->
    <div class="mt-14 pt-8 border-t border-cream-200/80 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <p class="text-xs text-slate-500 font-medium">
          Última actualización: octubre de 2026
        </p>
        <p class="text-xs text-slate-500 mt-1 max-w-md">
          La información de este sitio es orientativa y no reemplaza el asesoramiento profesional sobre cada caso.
        </p>
      </div>

      <a
        href={siteData.whatsapp.url}
        target="_blank"
        rel="noopener noreferrer"
        class="track-whatsapp inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base text-white bg-whatsapp hover:bg-whatsapp-hover transition-all shadow-md hover:shadow-lg flex-shrink-0 w-full sm:w-auto"
        data-location="faq-bottom"
      >
        <Icons name="whatsapp" class="w-5 h-5 text-white" />
        <span>¿No encontraste tu respuesta? Escribinos por WhatsApp</span>
      </a>
    </div>

  </div>
</section>

<script>
  // Deep-linking by URL hash support
  function handleFaqHash() {
    const rawHash = window.location.hash;
    if (!rawHash) return;

    const hash = rawHash.replace("#", "");
    const targetEl = document.getElementById(hash);

    if (targetEl && targetEl.classList.contains("faq-item")) {
      const details = targetEl as HTMLDetailsElement;
      details.open = true;
      setTimeout(() => {
        details.scrollIntoView({ behavior: "smooth", block: "center" });
      }, 150);
    }
  }

  window.addEventListener("hashchange", handleFaqHash);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", handleFaqHash);
  } else {
    handleFaqHash();
  }
</script>
