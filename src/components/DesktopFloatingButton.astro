---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<aside class="hidden lg:flex fixed bottom-6 right-6 z-40" aria-label="Contacto directo por WhatsApp">
  <a
    href={siteData.whatsapp.url}
    target="_blank"
    rel="noopener noreferrer"
    class="track-whatsapp group flex items-center gap-2.5 px-5 py-3 rounded-full font-bold text-white bg-whatsapp hover:bg-whatsapp-hover active:scale-[0.98] transition-all shadow-lg hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-whatsapp focus:ring-offset-2"
    data-location="floating-desktop"
    title="Escribinos por WhatsApp"
  >
    <Icons name="whatsapp" class="w-6 h-6 text-white transition-transform group-hover:scale-110" />
    <span class="text-sm font-bold tracking-wide">Escribinos</span>
  </a>
</aside>
