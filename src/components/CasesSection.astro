---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<section id="casos" class="py-16 sm:py-24 bg-white scroll-mt-20 border-t border-cream-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <span class="text-xs font-bold tracking-wider text-amber-800 uppercase font-sans">
        Especialización exclusiva
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-navy-950 font-serif mt-1 mb-3">
        Qué casos tomamos
      </h2>
      <p class="text-base sm:text-lg text-slate-700">
        Si tuviste un accidente de tránsito, es probable que tengas derecho a reclamar. Estos son los casos que atendemos todos los días en CABA y GBA Zona Norte.
      </p>
    </div>

    <!-- 6 Expandable Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {siteData.cases.map((item) => (
        <article class="case-card flex flex-col justify-between p-6 sm:p-7 rounded-2xl bg-cream-50/60 border border-cream-200/90 shadow-soft hover:shadow-card hover:border-amber-200 transition-all" data-case-id={item.id}>
          <div>
            <!-- Large Prominent SVG Icon Container -->
            <div class="w-12 h-12 rounded-xl bg-amber-900/10 text-amber-800 flex items-center justify-center mb-4 shadow-sm">
              <Icons name={item.icon} class="w-6 h-6 text-amber-800" />
            </div>

            <!-- Title (<h3>) -->
            <h3 class="text-lg sm:text-xl font-bold text-navy-950 font-serif leading-snug mb-2.5">
              {item.title}
            </h3>

            <!-- Resumen (Always Visible) -->
            <p class="text-sm font-medium text-slate-700 mb-3">
              {item.summary}
            </p>

            <!-- Texto Completo (Present in DOM for SEO Indexation) -->
            <div class="case-full-content text-sm text-slate-600 leading-relaxed space-y-3 pt-2 border-t border-cream-200/70">
              <p>{item.fullText}</p>
            </div>
          </div>

          <!-- Bottom Actions: Toggle & WhatsApp CTA -->
          <div class="pt-5 mt-4 border-t border-cream-200/50 flex flex-col gap-3">
            <button
              type="button"
              class="case-toggle-btn text-xs font-bold text-navy-800 hover:text-navy-950 inline-flex items-center gap-1.5 focus:outline-none"
              aria-expanded="false"
            >
              <span class="toggle-text">Leer más detalles</span>
              <svg class="toggle-icon w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </button>

            <!-- Expanded CTA Button -->
            <a
              href={siteData.whatsapp.url}
              target="_blank"
              rel="noopener noreferrer"
              class="track-whatsapp case-cta-btn hidden items-center justify-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm text-white bg-[#16A34A] hover:bg-[#15803D] transition-all shadow-sm"
              data-location={`casos-${item.id}`}
            >
              <Icons name="whatsapp" class="w-4 h-4 text-white" />
              <span>Consultar por mi caso</span>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  /* Progressive disclosure: Initial state clamps full text if screen is mobile/compact, or controlled by JS */
  .case-card:not(.is-expanded) .case-full-content {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .case-card.is-expanded .case-full-content {
    display: block;
  }
  .case-card.is-expanded .toggle-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  function setupCases() {
    const cards = document.querySelectorAll(".case-card");

    cards.forEach((card) => {
      const toggleBtn = card.querySelector<HTMLButtonElement>(".case-toggle-btn");
      const toggleText = card.querySelector<HTMLElement>(".toggle-text");
      const ctaBtn = card.querySelector<HTMLElement>(".case-cta-btn");

      if (!toggleBtn) return;

      toggleBtn.addEventListener("click", () => {
        const isExpanded = card.classList.toggle("is-expanded");
        toggleBtn.setAttribute("aria-expanded", String(isExpanded));

        if (toggleText) {
          toggleText.textContent = isExpanded ? "Mostrar menos" : "Leer más detalles";
        }

        if (ctaBtn) {
          if (isExpanded) {
            ctaBtn.classList.remove("hidden");
            ctaBtn.classList.add("inline-flex");
          } else {
            ctaBtn.classList.add("hidden");
            ctaBtn.classList.remove("inline-flex");
          }
        }
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCases);
  } else {
    setupCases();
  }
</script>
