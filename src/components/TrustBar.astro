---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<section class="bg-navy-950 text-white py-8 sm:py-10 border-y border-navy-900" aria-label="Garantías y diferenciales">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
      {siteData.trustBar.map((item) => (
        <div class="flex items-start gap-4 p-3 rounded-xl bg-navy-900/40 border border-navy-800/60">
          <div class="p-2.5 rounded-lg bg-navy-800/80 text-amber-400 flex-shrink-0">
            <Icons name={item.icon} class="w-6 h-6" />
          </div>
          <div>
            <div class="text-base font-bold text-white tracking-tight">
              {item.icon === "star" ? (
                <span>★ <span class="reviews-rating-val">{siteData.reviews.rating}</span> en Google</span>
              ) : (
                item.title
              )}
            </div>
            <p class="text-xs sm:text-sm text-slate-300 mt-0.5 leading-snug">
              {item.icon === "star" ? (
                <span class="reviews-trust-subtitle"><span class="reviews-count-dynamic">{siteData.reviews.count}</span> personas nos calificaron</span>
              ) : (
                item.subtitle
              )}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
