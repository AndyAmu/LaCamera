---
import { siteData } from "../config/siteData";
import Icons from "./Icons.astro";
---

<div
  id="mobile-bottom-bar"
  class="lg:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 px-3 py-2 shadow-card transition-all duration-300 ease-in-out transform translate-y-full opacity-0 pointer-events-none"
  role="region"
  aria-label="Acciones rápidas de contacto"
>
  <div class="max-w-md mx-auto">
    <!-- WhatsApp Button (Full Width) -->
    <a
      href={siteData.whatsapp.url}
      target="_blank"
      rel="noopener noreferrer"
      class="track-whatsapp w-full inline-flex items-center justify-center gap-2.5 py-3 px-4 rounded-xl font-bold text-sm sm:text-base text-white bg-whatsapp hover:bg-whatsapp-hover active:scale-[0.98] transition-all shadow-sm"
      data-location="bottom-bar-mobile"
    >
      <Icons name="whatsapp" class="w-5 h-5 text-white flex-shrink-0" />
      <span>Escribinos por WhatsApp</span>
    </a>
  </div>
</div>

<script>
  function setupMobileBar() {
    const bar = document.getElementById("mobile-bottom-bar");
    if (!bar) return;

    let isFormFocused = false;
    let isContactVisible = false;
    let isScrolledPast = false;

    function updateBarVisibility() {
      if (isScrolledPast && !isFormFocused && !isContactVisible) {
        bar.classList.remove("translate-y-full", "opacity-0", "pointer-events-none");
        bar.classList.add("translate-y-0", "opacity-100");
      } else {
        bar.classList.add("translate-y-full", "opacity-0", "pointer-events-none");
        bar.classList.remove("translate-y-0", "opacity-100");
      }
    }

    // Scroll listener: solo mostrar al hacer scroll hacia abajo (superados los 180px)
    function handleScroll() {
      const scrolled = window.scrollY > 180;
      if (scrolled !== isScrolledPast) {
        isScrolledPast = scrolled;
        updateBarVisibility();
      }
    }

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll(); // Chequeo inicial

    // Listen to form focus changes dispatched by ContactForm.astro
    window.addEventListener("form-focus-change", ((e: CustomEvent) => {
      isFormFocused = !!e.detail?.focused;
      updateBarVisibility();
    }) as EventListener);

    // Hide also when contact section is in viewport view to avoid overlapping
    const contactSection = document.getElementById("contacto");
    if (contactSection && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isContactVisible = entry.isIntersecting && entry.intersectionRatio > 0.3;
            updateBarVisibility();
          });
        },
        { threshold: [0, 0.3, 0.8] }
      );
      observer.observe(contactSection);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupMobileBar);
  } else {
    setupMobileBar();
  }
</script>
