---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import HowWeWork from "../components/HowWeWork.astro";
import CasesSection from "../components/CasesSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import WhatToDoSection from "../components/WhatToDoSection.astro";
import FaqSection from "../components/FaqSection.astro";
import VisitUsSection from "../components/VisitUsSection.astro";
import ContactSection from "../components/ContactSection.astro";
---

<Layout isHome={true}>
  <!-- 2.2 Hero -->
  <Hero />

  <!-- 2.3 Barra de confianza -->
  <TrustBar />

  <!-- 2.4 Cómo trabajamos -->
  <HowWeWork />

  <!-- 2.5 Qué casos tomamos -->
  <CasesSection />

  <!-- 2.6 Reseñas -->
  <ReviewsSection />

  <!-- 2.7 Qué hacer tras un accidente -->
  <WhatToDoSection />

  <!-- 2.8 Preguntas frecuentes -->
  <FaqSection />

  <!-- 2.9 Vení a tomar un café -->
  <VisitUsSection />

  <!-- 2.10 Contacto final -->
  <ContactSection />
</Layout>
